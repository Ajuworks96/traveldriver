# ==============================================================================
# TRAVEL & DRIVER TRIP MANAGEMENT SYSTEM - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=production

# PostgreSQL Database Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PRODUCTION_PASSWORD@localhost:5432/travel_driver_db?schema=public"

# Security & CORS Setup
# Comma-separated list of allowed frontend origins or specific admin dashboard domain
CORS_ORIGIN="http://localhost:5173,https://admin.youragency.com"

# JWT Authentication Secrets (Must be 32+ characters high-entropy strings in production)
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_SECRET_KEY_MIN_32_CHARS"
JWT_EXPIRES_IN="1d"

JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_REFRESH_SECRET_KEY_MIN_32_CHARS"
JWT_REFRESH_EXPIRES_IN="7d"

# Logging Configuration (options: error, warn, info, http, debug)
LOG_LEVEL="info"
