datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DRIVER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum TripStatus {
  ACTIVE
  COMPLETED
}

model User {
  id           String     @id @default(uuid())
  name         String
  phone        String?    @unique
  email        String     @unique
  passwordHash String
  role         Role       @default(DRIVER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  trips        Trip[]     @relation("DriverTrips")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Vehicle {
  id            String        @id @default(uuid())
  vehicleNumber String        @unique
  vehicleName   String
  model         String
  status        VehicleStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  trips         Trip[]        @relation("VehicleTrips")

  @@index([status])
  @@index([vehicleNumber])
  @@index([createdAt])
  @@map("vehicles")
}

model Trip {
  id          String     @id @default(uuid())
  driverId    String
  vehicleId   String
  destination String
  startKm     Decimal    @db.Decimal(10, 2)
  closingKm   Decimal?   @db.Decimal(10, 2)
  totalKm     Decimal?   @db.Decimal(10, 2)
  cashAmount  Decimal?   @default(0.00) @db.Decimal(10, 2)
  startTime   DateTime   @default(now())
  endTime     DateTime?
  status      TripStatus @default(ACTIVE)
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  driver      User       @relation("DriverTrips", fields: [driverId], references: [id], onDelete: Restrict)
  vehicle     Vehicle    @relation("VehicleTrips", fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([startTime])
  @@index([createdAt])
  @@index([driverId, status])
  @@index([vehicleId, status])
  @@map("trips")
}
